@page "/tecnicos"
@inject HttpClient Http

<PageTitle>Gestión de Técnicos | TechService</PageTitle>

<div class="container my-4">

    <!-- Encabezado -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-wrench-adjustable-circle-fill me-2"></i>Gestión de Técnicos
            </h2>
            <p class="text-muted mb-0">Administra el equipo de técnicos del taller y sus especialidades.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button class="btn btn-outline-primary" @onclick="CargarTecnicos" disabled="@cargando">
                <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
            </button>
        </div>
    </div>

    <!-- Alertas de éxito o error -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
        </div>
    }

    <div class="row g-4">

        <!-- Columna Izquierda: Formulario Crear / Editar -->

        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white py-3" style="background-color: #0b162c;">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi @(esEdicion ? "bi-pencil-square" : "bi-person-plus-fill") me-2 text-primary"></i>
                        @(esEdicion ? $"Editar Técnico #{tecnicoForm.TecnicoId}" : "Nuevo Técnico")
                    </h6>
                </div>

                <div class="card-body">
                    <EditForm Model="tecnicoForm" OnValidSubmit="GuardarTecnico">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre Completo</label>
                            <InputText class="form-control"
                                       placeholder="Ej: Carlos Mendoza"
                                       @bind-Value="tecnicoForm.Nombre"
                                       disabled="@guardando" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Especialidad</label>
                            <input type="text"
                                   class="form-control"
                                   list="listaEspecialidades"
                                   placeholder="Ej: Celulares y Microsoldadura"
                                   @bind="tecnicoForm.Especialidad"
                                   disabled="@guardando" />

                            <datalist id="listaEspecialidades">
                                <option value="Celulares y Microsoldadura" />
                                <option value="Laptops y Consolas" />
                                <option value="Consolas" />
                                <option value="Tablets y Pantallas" />
                                <option value="Software y Diagnóstico" />
                                <option value="General" />
                            </datalist>
                        </div>

                        <div class="d-grid gap-2">

                            <button type="submit" class="btn btn-primary fw-semibold" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-1"></i>
                                    <span>@(esEdicion ? "Actualizar Técnico" : "Registrar Técnico")</span>
                                }
                            </button>

                            @if (esEdicion)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelarEdicion" disabled="@guardando">
                                    <i class="bi bi-x-circle me-1"></i>Cancelar
                                </button>
                            }

                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Buscador y Tabla de Técnicos -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <div class="row g-2 align-items-center">

                        <div class="col-sm-6">
                            <h6 class="mb-0 fw-bold text-dark">
                                Listado de Técnicos
                                <span class="badge bg-primary-subtle text-primary ms-1">@tecnicosFiltrados.Count</span>
                            </h6>
                        </div>

                        <div class="col-sm-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" class="form-control"
                                       placeholder="Buscar por nombre, especialidad o ID..."
                                       @bind="textoBusqueda"
                                       @bind:event="oninput" />
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card-body p-0">

                    @if (cargando)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted mb-0">Cargando técnicos...</p>
                        </div>
                    }
                    else if (tecnicosFiltrados.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-wrench-adjustable fs-1 d-block mb-2"></i>
                            <p class="mb-0">No se encontraron técnicos registrados.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 80px;">ID</th>
                                        <th>Nombre</th>
                                        <th>Especialidad</th>
                                        <th class="text-end" style="width: 190px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tecnico in tecnicosFiltrados)
                                    {
                                        <tr>
                                            <td class="font-monospace text-muted">#@tecnico.TecnicoId</td>
                                            <td class="fw-semibold">@tecnico.Nombre</td>
                                            <td>
                                                <span class="badge bg-info-subtle text-info-emphasis px-2 py-1">
                                                    @(string.IsNullOrWhiteSpace(tecnico.Especialidad) ? "General" : tecnico.Especialidad)
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (idPendienteEliminar == tecnico.TecnicoId)
                                                {
                                                    <button class="btn btn-sm btn-danger me-1"
                                                            @onclick="() => EliminarTecnico(tecnico.TecnicoId)"
                                                            disabled="@eliminando">
                                                        Confirmar
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary"
                                                            @onclick="() => idPendienteEliminar = null"
                                                            disabled="@eliminando">
                                                        No
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-primary me-1"
                                                            title="Editar"
                                                            @onclick="() => SeleccionarParaEditar(tecnico)">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger"
                                                            title="Eliminar"
                                                            @onclick="() => idPendienteEliminar = tecnico.TecnicoId">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TecnicoDto> tecnicos = new();
    private TecnicoDto tecnicoForm = new();

    private string textoBusqueda = string.Empty;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    private bool cargando = true;
    private bool guardando = false;
    private bool eliminando = false;
    private int? idPendienteEliminar = null;

    private bool esEdicion => tecnicoForm.TecnicoId > 0;

    private List<TecnicoDto> tecnicosFiltrados => tecnicos
        .Where(t => string.IsNullOrWhiteSpace(textoBusqueda)
            || t.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
            || t.Especialidad.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
            || t.TecnicoId.ToString().Contains(textoBusqueda.Trim()))
        .OrderByDescending(t => t.TecnicoId)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarTecnicos();
    }

    private async Task CargarTecnicos()
    {
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var lista = await Http.GetFromJsonAsync<List<TecnicoDto>>("api/tecnicos");
            tecnicos = lista ?? new();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo cargar la lista de técnicos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarTecnico()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (string.IsNullOrWhiteSpace(tecnicoForm.Nombre))
        {
            mensajeError = "El nombre del técnico es obligatorio.";
            return;
        }

        tecnicoForm.Nombre = tecnicoForm.Nombre.Trim();
        tecnicoForm.Especialidad = string.IsNullOrWhiteSpace(tecnicoForm.Especialidad)
            ? "General"
            : tecnicoForm.Especialidad.Trim();

        guardando = true;

        try
        {
            HttpResponseMessage response;

            if (esEdicion)
            {
                response = await Http.PutAsJsonAsync($"api/tecnicos/{tecnicoForm.TecnicoId}", tecnicoForm);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/tecnicos", tecnicoForm);
            }

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = esEdicion
                    ? "Técnico actualizado correctamente."
                    : "Técnico registrado correctamente.";

                tecnicoForm = new();
                await CargarTecnicos();
            }
            else
            {
                mensajeError = "No se pudo guardar el técnico en el servidor.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar el técnico: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void SeleccionarParaEditar(TecnicoDto tecnico)
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        idPendienteEliminar = null;

        tecnicoForm = new TecnicoDto
        {
            TecnicoId = tecnico.TecnicoId,
            Nombre = tecnico.Nombre,
            Especialidad = tecnico.Especialidad
        };
    }

    private void CancelarEdicion()
    {
        tecnicoForm = new();
        mensajeError = string.Empty;
    }

    private async Task EliminarTecnico(int tecnicoId)
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        eliminando = true;

        try
        {
            var response = await Http.DeleteAsync($"api/tecnicos/{tecnicoId}");
            if (response.IsSuccessStatusCode)
            {
                mensajeExito = $"Técnico #{tecnicoId} eliminado correctamente.";
                if (tecnicoForm.TecnicoId == tecnicoId)
                {
                    tecnicoForm = new();
                }
                await CargarTecnicos();
            }
            else
            {
                mensajeError = "No se pudo eliminar el técnico (puede tener órdenes o usuarios asignados).";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar el técnico: {ex.Message}";
        }
        finally
        {
            eliminando = false;
            idPendienteEliminar = null;
        }
    }
}